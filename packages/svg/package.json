{
  "name": "@univerjs/icons-svg",
  "version": "1.47.1",
  "description": "SVG icons for Univer",
  "author": "DreamNum Co., Ltd. <developer@univer.ai>",
  "license": "MIT",
  "homepage": "https://docs.univer.ai/icons",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dream-num/univer-icons"
  },
  "bugs": {
    "url": "https://github.com/dream-num/univer-icons/issues"
  },
  "keywords": [
    "icons",
    "svg"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/canvas.d.ts",
      "default": "./dist/canvas.js"
    },
    "./double/*.svg": "./double/*.svg",
    "./other/*.svg": "./other/*.svg",
    "./single/*.svg": "./single/*.svg",
    "./manifest": "./manifest.json"
  },
  "files": [
    "double",
    "manifest.json",
    "other",
    "single",
    "dist"
  ],
  "scripts": {
    "prepare": "node --experimental-strip-types ./scripts/generate-manifest.mts && node ./scripts/generate-canvas.mts && tsrs -p tsconfig.json",
    "test": "node --test ./__tests__/*.spec.mts ./ts/__tests__/*.spec.mts"
  },
  "devDependencies": {
    "svg-parser": "^2.1.0",
    "@types/svg-parser": "^2.0.6"
  }
}
