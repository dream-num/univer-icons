{
  "name": "@univerjs/icons-workspace",
  "version": "1.50.2",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "description": "Icons used by Univer",
  "author": "DreamNum Co., Ltd. <developer@univer.ai>",
  "license": "MIT",
  "repository": "https://github.com/dream-num/univer-icons.git",
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "range": ">=22.18"
      },
      {
        "name": "pnpm",
        "range": ">=11"
      }
    ]
  },
  "scripts": {
    "build": "pnpm --filter @univerjs/icons-svg run prepare && pnpm --filter @univerjs/icons-svg run test && pnpm --filter ./packages/icons run build && pnpm --filter ./packages/icons-vue run build",
    "dev": "pnpm --filter ./packages/app dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "release": "verso"
  },
  "devDependencies": {
    "@amamo/oxlint-config": "^1.2.0",
    "@amamo/verso": "1.3.2",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tailwindcss": "^1.17.2",
    "simple-git-hooks": "^2.14.0",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,cts,mjs,mts}": "oxlint",
    "*.{md,markdown,yml,yaml}": "oxfmt --check ."
  }
}
